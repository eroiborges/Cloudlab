variable "handoff" {
  description = "Infrastructure contract generated by the foundation Terraform root."

  type = object({
    schema_version = number
    generated_by   = string
    azure = object({
      subscription_id = string
      tenant_id       = string
      location        = string
      resource_group = object({
        id   = string
        name = string
      })
    })
    naming = object({
      base_name = string
    })
    managed_identities = object({
      producer = object({
        id           = string
        name         = string
        client_id    = string
        principal_id = string
      })
      consumer = object({
        id           = string
        name         = string
        client_id    = string
        principal_id = string
      })
    })
    network = object({
      vnet = object({
        id   = string
        name = string
      })
      subnets = object({
        azhosts = object({
          id             = string
          name           = string
          address_prefix = string
        })
        pgsqlnet = object({
          id             = string
          name           = string
          address_prefix = string
        })
        aca = object({
          id             = string
          name           = string
          address_prefix = string
        })
        worker_aks = object({
          id             = string
          name           = string
          address_prefix = string
        })
      })
    })
    storage = object({
      id   = string
      name = string
    })
    key_vault = object({
      id   = string
      name = string
      uri  = string
    })
    service_bus = object({
      namespace = object({
        id       = string
        name     = string
        endpoint = string
      })
      queue = object({
        id   = string
        name = string
      })
    })
    container_registry = object({
      id           = string
      name         = string
      login_server = string
    })
  })

  nullable = false

  validation {
    condition     = var.handoff.schema_version == 2
    error_message = "Unsupported foundation handoff schema. Expected schema_version 2."
  }

  validation {
    condition     = var.handoff.generated_by == "container-function-foundation"
    error_message = "The handoff must be generated by container-function-foundation."
  }

  validation {
    condition = alltrue([
      can(regex("^[0-9a-fA-F-]{36}$", var.handoff.azure.subscription_id)),
      can(regex("^[0-9a-fA-F-]{36}$", var.handoff.azure.tenant_id)),
      can(regex("^/subscriptions/.+/resourceGroups/.+/providers/Microsoft.Network/virtualNetworks/.+/subnets/.+$", var.handoff.network.subnets.worker_aks.id)),
      can(regex("^[a-z0-9]+\\.azurecr\\.io$", var.handoff.container_registry.login_server)),
      can(regex("^[0-9a-fA-F-]{36}$", var.handoff.managed_identities.producer.client_id)),
      can(regex("^[0-9a-fA-F-]{36}$", var.handoff.managed_identities.consumer.client_id))
    ])
    error_message = "The handoff contains an invalid Azure identifier or endpoint."
  }
}

variable "aks" {
  description = "AKS cluster, identity, networking, and Kubernetes manifest configuration."

  type = object({
    cluster = object({
      name_prefix                        = string
      dns_prefix                         = string
      control_plane_identity_name_prefix = string
      kubernetes_version                 = string
      sku_tier                           = string
      automatic_upgrade_channel          = string
      node_os_upgrade_channel            = string
      node_provisioning_mode             = string
      local_account_disabled             = bool
      role_based_access_control_enabled  = bool
      ssh_admin_username                 = string
      ssh_public_key_path                = string
      tags                               = map(string)
    })
    system_node_pool = object({
      name                   = string
      node_count             = number
      vm_size                = string
      os_disk_type           = string
      os_disk_size_gb        = number
      os_sku                 = string
      max_pods               = number
      zones                  = list(string)
      node_public_ip_enabled = bool
      upgrade_settings = object({
        max_surge                     = string
        drain_timeout_in_minutes      = number
        node_soak_duration_in_minutes = number
      })
    })
    network = object({
      network_plugin      = string
      network_plugin_mode = string
      network_policy      = string
      load_balancer_sku   = string
      outbound_type       = string
      pod_cidr            = string
      service_cidr        = string
      dns_service_ip      = string
    })
    features = object({
      oidc_issuer_enabled       = bool
      workload_identity_enabled = bool
      keda_enabled              = bool
    })
    rbac = object({
      network_contributor_role_name       = string
      acr_pull_role_name                  = string
      key_vault_secrets_officer_role_name = string
    })
    federation = object({
      audience                 = string
      producer_credential_name = string
      consumer_credential_name = string
      keda_credential_name     = string
    })
    kubernetes = object({
      namespace = string
      producer = object({
        deployment_name      = string
        service_account_name = string
        container_name       = string
        image_repository     = string
        image_tag            = string
        host_id              = string
        replicas             = number
        min_replicas         = number
        max_replicas         = number
        cpu_request          = string
        memory_request       = string
        cpu_limit            = string
        memory_limit         = string
        container_port       = number
        service_type         = string
        hpa_cpu_utilization  = number
      })
      consumer = object({
        deployment_name                  = string
        service_account_name             = string
        container_name                   = string
        image_repository                 = string
        image_tag                        = string
        host_id                          = string
        replicas                         = number
        min_replicas                     = number
        max_replicas                     = number
        cpu_request                      = string
        memory_request                   = string
        cpu_limit                        = string
        memory_limit                     = string
        container_port                   = number
        polling_interval_seconds         = number
        cooldown_period_seconds          = number
        message_count                    = number
        activation_message_count         = number
        fallback_failure_threshold       = number
        fallback_replicas                = number
        scale_down_stabilization_seconds = number
      })
      probes = object({
        startup_period_seconds      = number
        startup_failure_threshold   = number
        readiness_period_seconds    = number
        readiness_timeout_seconds   = number
        readiness_failure_threshold = number
        liveness_period_seconds     = number
        liveness_timeout_seconds    = number
        liveness_failure_threshold  = number
      })
    })
  })

  nullable = false

  validation {
    condition = alltrue([
      can(regex("^[a-z][a-z0-9-]*-$", var.aks.cluster.name_prefix)),
      can(regex("^[a-z][a-z0-9-]*-$", var.aks.cluster.control_plane_identity_name_prefix)),
      length(var.aks.cluster.name_prefix) + length(var.handoff.naming.base_name) <= 63,
      length(var.aks.cluster.control_plane_identity_name_prefix) + length(var.handoff.naming.base_name) <= 128
    ])
    error_message = "AKS name prefixes must produce valid Azure resource names."
  }

  validation {
    condition     = can(regex("^[0-9]+\\.[0-9]+$", var.aks.cluster.kubernetes_version))
    error_message = "aks.cluster.kubernetes_version must pin a minor version such as 1.34."
  }

  validation {
    condition     = contains(["Auto", "Manual"], var.aks.cluster.node_provisioning_mode)
    error_message = "aks.cluster.node_provisioning_mode must be Auto or Manual."
  }

  validation {
    condition     = fileexists(pathexpand(var.aks.cluster.ssh_public_key_path))
    error_message = "aks.cluster.ssh_public_key_path must reference an existing public key."
  }

  validation {
    condition = (
      var.aks.system_node_pool.node_count >= 1 &&
      floor(var.aks.system_node_pool.node_count) == var.aks.system_node_pool.node_count &&
      var.aks.system_node_pool.os_disk_size_gb >= 30 &&
      var.aks.system_node_pool.max_pods >= 10 &&
      can(regex("^[1-9][0-9]*%?$", var.aks.system_node_pool.upgrade_settings.max_surge)) &&
      var.aks.system_node_pool.upgrade_settings.drain_timeout_in_minutes >= 0 &&
      var.aks.system_node_pool.upgrade_settings.node_soak_duration_in_minutes >= 0
    )
    error_message = "The system node pool and upgrade settings contain an invalid value."
  }

  validation {
    condition = (
      var.aks.features.oidc_issuer_enabled &&
      var.aks.features.workload_identity_enabled &&
      var.aks.features.keda_enabled
    )
    error_message = "OIDC issuer, Workload Identity, and KEDA must be enabled for this lab."
  }

  validation {
    condition = (
      var.aks.rbac.network_contributor_role_name == "Network Contributor" &&
      var.aks.rbac.acr_pull_role_name == "AcrPull" &&
      var.aks.rbac.key_vault_secrets_officer_role_name == "Key Vault Secrets Officer"
    )
    error_message = "AKS RBAC roles must match the approved least-privilege role matrix."
  }

  validation {
    condition = (
      var.aks.kubernetes.producer.host_id != var.aks.kubernetes.consumer.host_id &&
      alltrue([
        for host_id in [
          var.aks.kubernetes.producer.host_id,
          var.aks.kubernetes.consumer.host_id
        ] : can(regex("^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$", host_id))
      ])
    )
    error_message = "Function host IDs must be unique, lowercase, and no longer than 32 characters."
  }

  validation {
    condition = alltrue([
      for app in [
        var.aks.kubernetes.producer,
        var.aks.kubernetes.consumer
      ] :
      can(regex("^[a-z0-9]+(?:[._-][a-z0-9]+)*$", app.image_repository)) &&
      can(regex("^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$", app.image_tag))
    ])
    error_message = "AKS image repositories and tags must use valid container image syntax."
  }

  validation {
    condition = (
      var.aks.kubernetes.producer.min_replicas >= 1 &&
      var.aks.kubernetes.producer.max_replicas >= var.aks.kubernetes.producer.min_replicas &&
      var.aks.kubernetes.consumer.min_replicas >= 0 &&
      var.aks.kubernetes.consumer.max_replicas >= var.aks.kubernetes.consumer.min_replicas
    )
    error_message = "Producer and consumer replica ranges are invalid."
  }

}
