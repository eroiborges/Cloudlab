apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${producer_service_account_name}
  namespace: ${namespace}
  annotations:
    azure.workload.identity/client-id: "${producer_client_id}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${producer_deployment_name}
  namespace: ${namespace}
  labels:
    app: ${producer_deployment_name}
spec:
  replicas: ${producer_replicas}
  selector:
    matchLabels:
      app: ${producer_deployment_name}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app: ${producer_deployment_name}
        azure.workload.identity/use: "true"
    spec:
      serviceAccountName: ${producer_service_account_name}
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
      containers:
        - name: ${producer_container_name}
          image: "${acr_login_server}/${producer_image_repository}:${producer_image_tag}"
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: ${producer_container_port}
              protocol: TCP
          env:
            - name: AzureWebJobsStorage__blobServiceUri
              value: "https://${storage_name}.blob.core.windows.net"
            - name: AzureWebJobsStorage__queueServiceUri
              value: "https://${storage_name}.queue.core.windows.net"
            - name: AzureWebJobsStorage__tableServiceUri
              value: "https://${storage_name}.table.core.windows.net"
            - name: AzureWebJobsStorage__credential
              value: managedidentity
            - name: AzureWebJobsStorage__clientId
              value: "${producer_client_id}"
            - name: ServiceBusConnection__fullyQualifiedNamespace
              value: "${service_bus_namespace}.servicebus.windows.net"
            - name: ServiceBusConnection__credential
              value: managedidentity
            - name: ServiceBusConnection__clientId
              value: "${producer_client_id}"
            - name: AzureFunctionsWebHost__hostid
              value: "${producer_host_id}"
            - name: AzureWebJobsSecretStorageType
              value: keyvault
            - name: AzureWebJobsSecretStorageKeyVaultUri
              value: "${key_vault_uri}"
            - name: AzureWebJobsSecretStorageKeyVaultClientId
              value: "${producer_client_id}"
          resources:
            requests:
              cpu: "${producer_cpu_request}"
              memory: "${producer_memory_request}"
            limits:
              cpu: "${producer_cpu_limit}"
              memory: "${producer_memory_limit}"
          startupProbe:
            tcpSocket:
              port: http
            periodSeconds: ${startup_period_seconds}
            failureThreshold: ${startup_failure_threshold}
          readinessProbe:
            tcpSocket:
              port: http
            periodSeconds: ${readiness_period_seconds}
            timeoutSeconds: ${readiness_timeout_seconds}
            failureThreshold: ${readiness_failure_threshold}
          livenessProbe:
            tcpSocket:
              port: http
            periodSeconds: ${liveness_period_seconds}
            timeoutSeconds: ${liveness_timeout_seconds}
            failureThreshold: ${liveness_failure_threshold}
---
apiVersion: v1
kind: Service
metadata:
  name: ${producer_deployment_name}
  namespace: ${namespace}
  labels:
    app: ${producer_deployment_name}
spec:
  type: ${producer_service_type}
  selector:
    app: ${producer_deployment_name}
  ports:
    - name: http
      port: 80
      targetPort: http
      protocol: TCP
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: ${producer_deployment_name}
  namespace: ${namespace}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ${producer_deployment_name}
  minReplicas: ${producer_min_replicas}
  maxReplicas: ${producer_max_replicas}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: ${producer_hpa_cpu_utilization}
