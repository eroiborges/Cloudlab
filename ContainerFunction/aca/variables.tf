variable "handoff" {
  description = "Infrastructure contract generated by the foundation Terraform root."

  type = object({
    schema_version = number
    generated_by   = string
    azure = object({
      subscription_id = string
      tenant_id       = string
      location        = string
      resource_group = object({
        id   = string
        name = string
      })
    })
    naming = object({
      base_name = string
    })
    managed_identities = object({
      producer = object({
        id           = string
        name         = string
        client_id    = string
        principal_id = string
      })
      consumer = object({
        id           = string
        name         = string
        client_id    = string
        principal_id = string
      })
    })
    network = object({
      vnet = object({
        id   = string
        name = string
      })
      subnets = object({
        azhosts = object({
          id             = string
          name           = string
          address_prefix = string
        })
        pgsqlnet = object({
          id             = string
          name           = string
          address_prefix = string
        })
        aca = object({
          id             = string
          name           = string
          address_prefix = string
        })
        worker_aks = object({
          id             = string
          name           = string
          address_prefix = string
        })
      })
    })
    storage = object({
      id   = string
      name = string
    })
    key_vault = object({
      id   = string
      name = string
      uri  = string
    })
    service_bus = object({
      namespace = object({
        id       = string
        name     = string
        endpoint = string
      })
      queue = object({
        id   = string
        name = string
      })
    })
    container_registry = object({
      id           = string
      name         = string
      login_server = string
    })
  })

  nullable = false

  validation {
    condition     = var.handoff.schema_version == 2
    error_message = "Unsupported foundation handoff schema. Expected schema_version 2."
  }

  validation {
    condition     = var.handoff.generated_by == "container-function-foundation"
    error_message = "The handoff must be generated by container-function-foundation."
  }

  validation {
    condition = alltrue([
      can(regex("^[0-9a-fA-F-]{36}$", var.handoff.azure.subscription_id)),
      can(regex("^[0-9a-fA-F-]{36}$", var.handoff.azure.tenant_id)),
      can(regex("^/subscriptions/.+/resourceGroups/.+/providers/Microsoft.Network/virtualNetworks/.+/subnets/.+$", var.handoff.network.subnets.aca.id)),
      can(regex("^[a-z0-9]+\\.azurecr\\.io$", var.handoff.container_registry.login_server)),
      can(regex("^[0-9a-fA-F-]{36}$", var.handoff.managed_identities.producer.client_id)),
      can(regex("^[0-9a-fA-F-]{36}$", var.handoff.managed_identities.consumer.client_id))
    ])
    error_message = "The handoff contains an invalid Azure identifier or endpoint."
  }
}

variable "aca" {
  description = "Azure Container Apps environment and function app configuration."

  type = object({
    container_app_api_version = string
    environment = object({
      name_prefix                    = string
      internal_load_balancer_enabled = bool
      zone_redundancy_enabled        = bool
      logs_destination               = string
      workload_profile_name          = string
      workload_profile_type          = string
    })
    producer = object({
      name_prefix      = string
      container_name   = string
      image_repository = string
      image_tag        = string
      revision_mode    = string
      cpu              = number
      memory           = string
      min_replicas     = number
      max_replicas     = number
      ingress = object({
        external_enabled           = bool
        target_port                = number
        transport                  = string
        allow_insecure_connections = bool
      })
      cors = object({
        allowed_origins           = list(string)
        allowed_methods           = list(string)
        allowed_headers           = list(string)
        exposed_headers           = list(string)
        allow_credentials_enabled = bool
        max_age_in_seconds        = number
      })
    })
    consumer = object({
      name_prefix      = string
      container_name   = string
      image_repository = string
      image_tag        = string
      revision_mode    = string
      cpu              = number
      memory           = string
      min_replicas     = number
      max_replicas     = number
      ingress = object({
        external_enabled           = bool
        target_port                = number
        transport                  = string
        allow_insecure_connections = bool
      })
    })
  })

  nullable = false

  validation {
    condition     = can(regex("^20[0-9]{2}-[0-9]{2}-[0-9]{2}$", var.aca.container_app_api_version))
    error_message = "aca.container_app_api_version must be a stable date-based API version."
  }

  validation {
    condition = alltrue([
      for prefix in [
        var.aca.environment.name_prefix,
        var.aca.producer.name_prefix,
        var.aca.consumer.name_prefix
      ] : can(regex("^[a-z][a-z0-9-]*-$", prefix))
    ])
    error_message = "ACA name prefixes must start with a lowercase letter, end with a hyphen, and contain only lowercase letters, numbers, or hyphens."
  }

  validation {
    condition = (
      length(var.aca.environment.name_prefix) + length(var.handoff.naming.base_name) <= 60 &&
      length(var.aca.producer.name_prefix) + length(var.handoff.naming.base_name) <= 32 &&
      length(var.aca.consumer.name_prefix) + length(var.handoff.naming.base_name) <= 32
    )
    error_message = "Generated ACA names exceed the Azure limits of 60 characters for environments or 32 characters for container apps."
  }

  validation {
    condition = (
      var.aca.environment.workload_profile_name == "Consumption" &&
      var.aca.environment.workload_profile_type == "Consumption"
    )
    error_message = "This lab supports only the Consumption workload profile."
  }

  validation {
    condition     = contains(["none", "azure-monitor", "log-analytics"], var.aca.environment.logs_destination)
    error_message = "aca.environment.logs_destination must be none, azure-monitor, or log-analytics."
  }

  validation {
    condition = alltrue([
      for app in [var.aca.producer, var.aca.consumer] :
      can(regex("^[a-z0-9]+(?:[._-][a-z0-9]+)*$", app.image_repository)) &&
      can(regex("^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$", app.image_tag)) &&
      can(regex("^[a-z0-9][a-z0-9-]*[a-z0-9]$", app.container_name))
    ])
    error_message = "Container names, image repositories, and image tags must use valid container naming syntax."
  }

  validation {
    condition = alltrue([
      for app in [var.aca.producer, var.aca.consumer] :
      contains(["Single", "Multiple"], app.revision_mode) &&
      app.cpu >= 0.25 &&
      app.cpu <= 4 &&
      can(regex("^[0-9]+(?:\\.[0-9]+)?Gi$", app.memory))
    ])
    error_message = "Each app must use a supported revision mode, 0.25-4 CPU cores, and memory expressed in Gi."
  }

  validation {
    condition = alltrue([
      for app in [var.aca.producer, var.aca.consumer] :
      app.min_replicas >= 0 &&
      app.max_replicas >= app.min_replicas &&
      app.max_replicas <= 300 &&
      floor(app.min_replicas) == app.min_replicas &&
      floor(app.max_replicas) == app.max_replicas
    ])
    error_message = "Replica counts must be whole numbers with 0 <= min_replicas <= max_replicas <= 300."
  }

  validation {
    condition = alltrue([
      for ingress in [var.aca.producer.ingress, var.aca.consumer.ingress] :
      ingress.target_port >= 1 &&
      ingress.target_port <= 65535 &&
      contains(["auto", "http", "http2", "tcp"], ingress.transport)
    ])
    error_message = "Ingress target ports must be 1-65535 and transport must be auto, http, http2, or tcp."
  }

  validation {
    condition     = var.aca.producer.ingress.external_enabled && !var.aca.consumer.ingress.external_enabled
    error_message = "The producer ingress must be external and the consumer ingress must be internal."
  }

  validation {
    condition = (
      length(var.aca.producer.cors.allowed_origins) > 0 &&
      alltrue([
        for origin in var.aca.producer.cors.allowed_origins :
        origin == "*" || can(regex("^https?://", origin))
      ]) &&
      var.aca.producer.cors.max_age_in_seconds >= 0 &&
      var.aca.producer.cors.max_age_in_seconds <= 86400 &&
      !(var.aca.producer.cors.allow_credentials_enabled && contains(var.aca.producer.cors.allowed_origins, "*"))
    )
    error_message = "Producer CORS must contain valid origins, use a max age of 0-86400 seconds, and cannot combine credentials with a wildcard origin."
  }
}
