variable "aws_region" {
  type        = string
  default     = "us-east-1"
  description = "AWS region used by the provider. Route 53 is a global service."
}

variable "handoff" {
  description = "DNS handoff generated by the Azure Web App Terraform root."

  type = object({
    schema_version = number
    generated_by   = string
    custom_domain  = string
    azure = object({
      resource_group_name = string
      web_app_name        = string
      default_hostname    = string
      certificate_id      = string
    })
    route53 = object({
      public_zone_name = string
      records = list(object({
        purpose = string
        name    = string
        fqdn    = string
        type    = string
        ttl     = number
        values  = list(string)
      }))
    })
  })

  validation {
    condition     = var.handoff.schema_version == 1
    error_message = "Unsupported handoff schema version. Expected version 1."
  }

  validation {
    condition     = var.handoff.generated_by == "azure-webapp-terraform"
    error_message = "The handoff wasn't generated by the expected Azure Web App Terraform root."
  }

  validation {
    condition = alltrue([
      for record in var.handoff.route53.records :
      contains(["TXT", "CNAME"], record.type)
    ])
    error_message = "This pilot supports only TXT and CNAME records."
  }
}
