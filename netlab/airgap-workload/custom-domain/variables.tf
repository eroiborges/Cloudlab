variable "handoff" {
  description = "Pipeline handoff generated by the base Azure Terraform root."
  type = object({
    schema_version = number
    generated_by   = string
    custom_domain  = string
    azure = object({
      resource_group_name = string
      web_app_name        = string
      default_hostname    = string
      certificate_id      = string
    })
    route53 = object({
      public_zone_name = string
      records = list(object({
        purpose = string
        name    = string
        fqdn    = string
        type    = string
        ttl     = number
        values  = list(string)
      }))
    })
  })
}

variable "dns_validation_confirmed" {
  type        = bool
  default     = false
  description = "Explicit gate. Set to true only after the TXT and CNAME records resolve from public DNS."
}